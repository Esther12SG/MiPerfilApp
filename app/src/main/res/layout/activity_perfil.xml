<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF7F2"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="#AFC8B8"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mi Perfil"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#4F433D" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Esther Sierra · Creadora"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#6F625C"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="22dp"
            android:layout_marginRight="22dp"
            android:layout_marginTop="-48dp"
            android:layout_marginBottom="25dp"
            app:cardBackgroundColor="#FFFDFC"
            app:cardCornerRadius="30dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="28dp">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="170dp"
                    android:layout_height="170dp"
                    app:cardCornerRadius="85dp"
                    app:cardElevation="5dp"
                    app:strokeColor="#C9C2D8"
                    app:strokeWidth="4dp">

                    <ImageView
                        android:id="@+id/imgPerfil"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@android:drawable/ic_menu_camera"
                        android:background="#F7F2ED"
                        android:padding="38dp"
                        android:scaleType="centerCrop"
                        android:contentDescription="Imagen de perfil" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/txtNombrePerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Nombre del usuario"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="#4F433D"
                    android:layout_marginTop="22dp" />

                <TextView
                    android:id="@+id/txtCorreoPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="correo@ejemplo.com"
                    android:textSize="16sp"
                    android:textColor="#7D716B"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="26dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTomarFoto"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:text="Tomar fotografía"
                    android:textAllCaps="false"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#4F433D"
                    app:backgroundTint="#E9C7B8"
                    app:cornerRadius="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGaleria"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="12dp"
                    android:text="Elegir de galería"
                    android:textAllCaps="false"
                    android:textSize="17sp"
                    android:textColor="#4F433D"
                    app:backgroundTint="#C9C2D8"
                    app:cornerRadius="18dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCerrarSesion"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="18dp"
                    android:text="Cerrar sesión"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    android:textColor="#4F433D"
                    app:backgroundTint="#DCE8DF"
                    app:cornerRadius="18dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>